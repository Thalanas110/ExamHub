{
    "name": "examsys/backend",
    "description": "Exam system PHP backend API",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "bootstrap-database": "php scripts/bootstrap_database.php",
        "smoke-test": "php tests/SecuritySmokeTest.php",
        "exam-validation-test": "php tests/ExamValidationTest.php",
        "encryption-storage-test": "php tests/EncryptionStorageCompatibilityTest.php",
        "transport-encryption-test": "php tests/TransportPayloadEnvelopeTest.php",
        "generate-fake-users-csv": "php scripts/generate_fake_users_csv.php",
        "import-fake-users-csv": "php scripts/import_fake_users_csv.php",
        "seed-fake-users": [
            "@generate-fake-users-csv",
            "@import-fake-users-csv"
        ],
        "generate-fake-exam-csv": "php scripts/generate_fake_exam_data_csv.php",
        "import-fake-exam-csv": "php scripts/import_fake_exam_data_csv.php",
        "seed-fake-exams": [
            "@generate-fake-exam-csv",
            "@import-fake-exam-csv"
        ],
        "purge-log-retention": "php scripts/purge_log_retention.php",
        "repair-encrypted-storage": "php scripts/repair_encrypted_storage.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
