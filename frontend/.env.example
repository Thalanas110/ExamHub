# Frontend API base URL for the PHP backend
# Leave blank locally to auto-use `/api` (Vite dev proxy) in development.
# Local XAMPP/Laragon folder-host example:
# VITE_PHP_BASE_URL=http://localhost/group8/api
# Local Laragon virtual-host example:
# VITE_PHP_BASE_URL=http://group8.test/api
# Vercel + Render hosted example:
# VITE_PHP_BASE_URL=https://your-render-service.onrender.com/api
VITE_PHP_BASE_URL=

# AES-256-GCM transport key for request/response payload encryption.
# Must be the exact same value as backend APP_ENCRYPTION_KEY.
# Supported formats: raw 32-byte string, plain base64, base64:<...>, or 64-char hex.
# Example:
# VITE_TRANSPORT_ENCRYPTION_KEY=base64:MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
VITE_TRANSPORT_ENCRYPTION_KEY=

# Optional local dev proxy overrides (used only by Vite dev server):
# VITE_DEV_PHP_PROXY_TARGET=http://localhost
# VITE_DEV_PHP_PROXY_BASE_PATH=/group8/api/index.php
# For virtual-host mode with working rewrites, use:
# VITE_DEV_PHP_PROXY_BASE_PATH=/api
