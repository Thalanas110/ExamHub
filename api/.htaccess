# XAMPP serves the PHP 8.5 API through CGI. Preserve bearer credentials so
# Request::bearerToken() can authenticate protected API routes.
CGIPassAuth On

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} ^(.+)$
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]
</IfModule>
